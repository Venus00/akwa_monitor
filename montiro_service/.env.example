SSH_USER=admin
SSH_PASSWORD=replace-me
SSH_PORT=22
SSH_CONNECT_TIMEOUT=8
SSH_STRICT_HOST_KEY_CHECKING=accept-new
DEVICE_LOG_PATH=/home/admin/device-client-logs
WIFI_SSID=NXT-AP2
WIFI_PASSWORD=replace-me
# Set ENABLE_WIFI_CONNECT=true only if the local runner should ask every board to join the AP.
ENABLE_WIFI_CONNECT=false
